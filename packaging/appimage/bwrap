#!/usr/bin/env bash
# EN-US: Expose immutable AppImage decoder libraries while retaining Glycin's sandbox restrictions.
# PT-BR: Disponibiliza bibliotecas imutáveis de decodificação do AppImage mantendo as restrições de isolamento do Glycin.
# Glycin clears LD_LIBRARY_PATH and only mounts its executable. Add the immutable
# AppDir so its portable decoder libraries remain available inside the sandbox.
# Existing namespace, seccomp, read-only filesystem and network rules stay active.
set -euo pipefail
if [[ $# -eq 0 ]]; then
    exec "$PAPO_APPDIR/usr/libexec/bwrap.real"
fi
papo_arguments=("$@")
papo_index=0
# Locate COMMAND while retaining its arguments (Glycin uses --dbus-fd).
while (( papo_index < ${#papo_arguments[@]} )); do
    case "${papo_arguments[papo_index]}" in
        --) papo_index=$((papo_index+1)); break ;;
        --ro-bind|--ro-bind-try|--bind|--bind-try|--dev-bind|--dev-bind-try|--symlink|--setenv|--file|--bind-data|--ro-bind-data|--chmod)
            papo_index=$((papo_index+3)) ;;
        --chdir|--dev|--proc|--tmpfs|--dir|--seccomp|--add-seccomp-fd|--unsetenv|--uid|--gid|--cap-add|--cap-drop|--perms|--size|--lock-file|--sync-fd|--block-fd|--userns|--userns2|--pidns|--info-fd|--json-status-fd|--hostname|--argv0|--remount-ro)
            papo_index=$((papo_index+2)) ;;
        --unshare-*|--share-net|--die-with-parent|--new-session|--clearenv|--as-pid-1|--disable-userns|--assert-userns-disabled)
            papo_index=$((papo_index+1)) ;;
        --*) printf 'Unsupported image sandbox option: %s\n' "${papo_arguments[papo_index]}" >&2; exit 2 ;;
        *) break ;;
    esac
done
papo_options=("${papo_arguments[@]:0:papo_index}")
papo_command=("${papo_arguments[@]:papo_index}")
papo_environment=(--setenv LD_LIBRARY_PATH "$PAPO_APPDIR/usr/lib64")
if [[ -n "${FONTCONFIG_FILE:-}" ]]; then
    papo_environment+=(--setenv FONTCONFIG_FILE "$FONTCONFIG_FILE")
fi
exec "$PAPO_APPDIR/usr/libexec/bwrap.real" "${papo_options[@]}" \
    --ro-bind "$PAPO_APPDIR" "$PAPO_APPDIR" "${papo_environment[@]}" "${papo_command[@]}"
