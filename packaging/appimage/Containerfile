FROM registry.fedoraproject.org/fedora:44

# Match current Fedora/Arch desktops rather than rebuilding older GTK releases.
# RPM Fusion's free codec library restores H.264/AAC support omitted from Fedora.
RUN dnf -y --refresh install \
    gcc gcc-c++ rust cargo git pkgconf-pkg-config glib2-devel openssl-devel \
    gtk4-devel libadwaita-devel python3-gobject python3-cairo python3-gstreamer1 \
    gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-plugins-bad-free \
    gstreamer1-plugin-libav gstreamer1-plugins-ugly-free libnice-gstreamer1 \
    pipewire-gstreamer gstreamer1 librsvg2 gdk-pixbuf2 \
    adwaita-icon-theme adwaita-sans-fonts adwaita-mono-fonts \
    google-noto-sans-vf-fonts google-noto-color-emoji-fonts dejavu-sans-fonts \
    fontconfig desktop-file-utils squashfs-tools ca-certificates \
    xorg-x11-server-Xvfb xorg-x11-xauth dbus-daemon weston mesa-dri-drivers && \
    dnf -y install https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-44.noarch.rpm && \
    dnf -y install libavcodec-freeworld && dnf clean all

# Ship GTK clients for the desktop input-method services, without bundling daemons.
RUN dnf -y --refresh install ibus-gtk4 fcitx5-gtk4 && dnf clean all

# Both optional GPU plugins must be present even in this GPU-less builder.
# GPU drivers are supplied by the target desktop, not copied from the builder.
RUN test -f /usr/lib64/gstreamer-1.0/libgstva.so && \
    test -f /usr/lib64/gstreamer-1.0/libgstnvcodec.so


ENV CARGO_HOME=/cargo \
    CARGO_TARGET_DIR=/work/target/appimage-fedora44
WORKDIR /work
