[
  "qemu-system-x86_64",
  "-name",
  "papo-clean-windows",
  "-machine",
  "q35,smm=on",
  "-accel",
  "kvm",
  "-cpu",
  "host",
  "-smp",
  "4",
  "-m",
  "6144",
  "-global",
  "driver=cfi.pflash01,property=secure,value=on",
  "-drive",
  "if=pflash,format=qcow2,readonly=on,file=/usr/share/edk2/ovmf/OVMF_CODE_4M.secboot.qcow2",
  "-drive",
  "if=pflash,format=qcow2,file=${WORKSPACE}/target/windows-clean-vm/clean/uefi-vars.qcow2",
  "-drive",
  "file=${WORKSPACE}/target/windows-clean-vm/clean/os.qcow2,format=qcow2,if=ide,index=0",
  "-drive",
  "file=${WORKSPACE}/target/windows-clean-vm/windows11.iso,media=cdrom,readonly=on,if=ide,index=2",
  "-drive",
  "file=${WORKSPACE}/target/windows-clean-vm/clean/input.iso,media=cdrom,readonly=on,if=ide,index=3",
  "-device",
  "qemu-xhci,id=usb",
  "-drive",
  "if=none,id=results,format=raw,file=${WORKSPACE}/target/windows-clean-vm/clean/results.img",
  "-device",
  "usb-tablet,bus=usb.0",
  "-chardev",
  "socket,id=chrtpm,path=/tmp/papo-windows-clean-vm/tpm.sock",
  "-tpmdev",
  "emulator,id=tpm0,chardev=chrtpm",
  "-device",
  "tpm-crb,tpmdev=tpm0",
  "-vga",
  "none",
  "-device",
  "VGA,vgamem_mb=64,xres=1280,yres=800",
  "-display",
  "none",
  "-nic",
  "none",
  "-boot",
  "order=c,menu=on",
  "-qmp",
  "unix:/tmp/papo-windows-clean-vm/qmp.sock,server=on,wait=off",
  "-monitor",
  "none",
  "-rtc",
  "base=utc,clock=host",
  "-device",
  "usb-storage,bus=usb.0,drive=results,removable=on"
]
