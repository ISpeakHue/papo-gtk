FROM registry.fedoraproject.org/fedora:44
# EN-US: Match the modern Linux runtime and retain all decoder isolation dependencies.
# PT-BR: Usa o runtime Linux moderno e preserva as dependências do isolamento dos decodificadores.
RUN dnf install -y bubblewrap git gcc rust cargo pkgconf-pkg-config glib2-devel \
    openssl-devel gtk4-devel libadwaita-devel python3-gobject python3-gstreamer1 \
    gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-plugins-bad-free \
    gstreamer1-plugin-openh264 gstreamer1-plugin-libav \
    libnice-gstreamer1 xorg-x11-server-Xvfb xorg-x11-xauth setxkbmap libXtst \
    dbus-daemon glycin-loaders librsvg2 fontconfig dejavu-sans-fonts openbox xprop && dnf clean all
WORKDIR /work
